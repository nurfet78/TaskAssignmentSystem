POSTGRES_VERSION=18
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=taskassigndb

# Порт базы на хосте: только число, без адреса.
DB_PORT=5432

# Политика перезапуска контейнеров: no (по умолчанию) или unless-stopped (для сервера).
# RESTART_POLICY=unless-stopped

# Swagger UI в Docker Compose: по умолчанию выключен (как положено для prod).
# Для локальной проверки поставьте true и перезапустите: docker compose up -d
# SWAGGER_ENABLED=true